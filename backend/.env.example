# Copy to `backend/.env` for local runs. Values are illustrative only — never commit real secrets.
#
# Operator reference: see "Mode matrix" at the bottom of this file.
# Remediation tracker: ../V1_REMEDIATION_EXECUTION.md

# --- Core API ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (local or Atlas)
# Prefer mongodb+srv on macOS/Linux. On Windows, if Node fails SRV lookup (querySrv ECONNREFUSED),
# use a direct replica-set URI from Atlas Connect → Drivers → "Standard connection string".
MONGODB_URI=mongodb://127.0.0.1:27017/zuggernaut_dev

# Auth (required for API startup in non-test environments)
JWT_SECRET=change-me-use-at-least-32-characters-long!!
JWT_EXPIRES_IN=2h

# OAuth token encryption at rest (required for API + worker — mock OAuth still persists encrypted tokens)
# 64 hex chars OR base64-encoded 32 bytes. Generate hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SPA origin(s) for CORS and OAuth redirects (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Public API base URL (OAuth callback default when GOOGLE_OAUTH_REDIRECT_URI unset)
# Production: set to your Railway API origin, e.g. https://zuggernaut-api.up.railway.app
# API_PUBLIC_BASE_URL=https://your-api.up.railway.app

# Google OAuth redirect (optional if API_PUBLIC_BASE_URL is set)
# Production: https://your-api.up.railway.app/api/v1/integrations/google/callback
# GOOGLE_OAUTH_REDIRECT_URI=

# Set false for local http dev when cookies must not require Secure
# COOKIE_SECURE=false

# Session cookie SameSite override (default: lax in dev; none in production when FRONTEND_ORIGIN is set)
# COOKIE_SAMESITE=none

# --- Temporal (required for setup runs) ---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=setup-run
# Temporal Cloud mTLS (production): set TEMPORAL_CLOUD_TLS=true plus cert/key below.
# TEMPORAL_CLOUD_TLS=false
# TEMPORAL_CLIENT_CERT=
# TEMPORAL_CLIENT_KEY=
# TEMPORAL_SERVER_NAME_OVERRIDE=

# --- Google OAuth ---
# Mock: skips real Google authorize/token exchange; still stores encrypted mock tokens.
GOOGLE_OAUTH_MOCK=true
# Real mode: set GOOGLE_OAUTH_MOCK=false and provide credentials below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# --- Google Tag Manager API ---
GTM_API_MOCK=true
# Real mode: GTM_API_MOCK=false and GTM_API_ENABLED=true
# GTM_API_ENABLED=false

# --- Google Ads API ---
GOOGLE_ADS_API_MOCK=true
# Real mode: GOOGLE_ADS_API_MOCK=false and GOOGLE_ADS_API_ENABLED=true
# GOOGLE_ADS_API_ENABLED=false
# Opt-in write path: programmatically create missing conversion actions (disabled by default)
GOOGLE_ADS_CONVERSION_ACTION_CREATION_ENABLED=false
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# MCC admin refresh token — required for MCC link invite operations in production (server secret, not tenant OAuth).
# GOOGLE_ADS_MCC_REFRESH_TOKEN=
# GOOGLE_ADS_TEST_MANAGER_CUSTOMER_ID=
# Separate test manager (create at https://ads.google.com/aw/test-account). Required for
# npm run debug:google-ads-create-test-account when using a test developer token.
# Dev integrations: prefer this test client when listing selectable customers (digits only):
# GOOGLE_ADS_PREFERRED_TEST_CUSTOMER_ID=5369183891
GOOGLE_ADS_API_VERSION=v24
# GOOGLE_ADS_DEFAULT_CURRENCY_CODE=USD
# GOOGLE_ADS_DEFAULT_TIME_ZONE=America/New_York

# --- Lead campaign MVP ---
# Bounded whole-site scrape (homepage + additional same-origin pages). Default: 15
# SCRAPE_MAX_PAGES=15
# Comma-separated ISO country codes eligible for call campaigns (default US,IN)
# LEAD_CAMPAIGN_FORWARDING_COUNTRIES=US,IN
# LLM for intake answers / campaign planning (disabled unless both are set)
# LLM_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional email for Task 41 disapproval operator alerts (console transport in dev)
# OPERATOR_ALERT_EMAIL=
# Stripe price IDs — required before price-derived subscription mapping (Task 36)
# STRIPE_PRICE_ID_STARTER=
# STRIPE_PRICE_ID_MIDDLE=
# STRIPE_PRICE_ID_TOP=

# --- Google Business Profile (read-only audit) ---
GBP_API_MOCK=true
# Real mode: GBP_API_MOCK=false and GBP_API_ENABLED=true
# GBP_API_ENABLED=false

# --- Dev-only integration diagnostics (never enable in production) ---
# Backend (required for /api/v1/dev/integrations):
# ENABLE_INTEGRATION_DIAGNOSTICS=true
# Frontend (Vite): VITE_ENABLE_INTEGRATION_DIAGNOSTICS=true → http://localhost:5173/dev/integrations
# Creation diagnostics CLI: npm run debug:dev-integrations-flow -- <businessId> --provider gtm --creation-diagnostics
# Optional GTM diagnostic tags when business has no GA4/conversion config:
# GTM_DIAGNOSTIC_GA4_MEASUREMENT_ID=G-XXXXXXXX
# GTM_DIAGNOSTIC_GOOGLE_ADS_CONVERSION_ID=
# GTM_DIAGNOSTIC_GOOGLE_ADS_CONVERSION_LABEL=

# Dev/test only — skips subscription gate for setup_start + campaign_enable.
# Hard-blocked outside NODE_ENV=development|test. Logs a warning when active.
BILLING_FREE_PLAN_TEST=false

# Soft-launch product constraints (forms-only goals, single business, no setup reruns).
SOFT_LAUNCH_MODE=false

# Comma-separated tester emails allowed to bypass subscription gate when SOFT_LAUNCH_MODE=true.
SOFT_LAUNCH_TESTER_EMAILS=

# --- Optional tuning ---
# PROVIDER_RATE_LIMIT_MS=200
# SCRAPER_USER_AGENT=ZuggernautBot/1.0 (+https://zuggernaut.app)
# SCRAPER_INTER_REQUEST_DELAY_MS=450

# =============================================================================
# Mode matrix (operator)
# =============================================================================
#
# | Variable                  | Mock mode (local E2E)     | Real mode (Google APIs)        |
# |---------------------------|---------------------------|--------------------------------|
# | JWT_SECRET                | required (32+ chars)      | required                       |
# | TOKEN_ENCRYPTION_KEY      | required                  | required                       |
# | MONGODB_URI               | required                  | required                       |
# | FRONTEND_ORIGIN           | required (match SPA URL)  | required (production SPA URL)  |
# | TEMPORAL_ADDRESS          | required (local or cloud) | required (Temporal Cloud/host) |
# | TEMPORAL_NAMESPACE        | default                   | your namespace                 |
# | TEMPORAL_TASK_QUEUE       | setup-run                 | same on API + worker           |
# | GOOGLE_OAUTH_MOCK         | true                      | false (unset or false)         |
# | GOOGLE_CLIENT_ID/SECRET   | optional in mock          | required                       |
# | GTM_API_MOCK              | true                      | false                          |
# | GTM_API_ENABLED           | omit or false             | true                           |
# | GOOGLE_ADS_API_MOCK       | true                      | false                          |
# | GOOGLE_ADS_API_ENABLED    | omit or false             | true                           |
# | GOOGLE_ADS_CONVERSION_ACTION_CREATION_ENABLED | false (default) | true (opt-in writes) |
# | GOOGLE_ADS_DEVELOPER_TOKEN| optional in mock          | required                       |
# | GOOGLE_ADS_LOGIN_CUSTOMER_ID | optional in mock       | required (MCC)                 |
# | GOOGLE_ADS_MCC_REFRESH_TOKEN | optional in mock       | required (MCC link invites)    |
# | API_PUBLIC_BASE_URL or GOOGLE_OAUTH_REDIRECT_URI | optional in mock | required (OAuth callback) |
# | TEMPORAL_CLOUD_TLS + cert/key | unset (local tls:false) | true + mTLS for Temporal Cloud |
# | GBP_API_MOCK              | true                      | false                          |
# | GBP_API_ENABLED           | omit or false             | true                           |
#
# Mock mode checklist: dev-tools/docs/MANUAL_E2E_CHECKLIST.md
# Real mode checklist (Phase 4): dev-tools/docs/REAL_MODE_E2E_CHECKLIST.md
# Real mode preflight: npm run verify:real-mode-env
# Always run exactly one Temporal worker per TEMPORAL_TASK_QUEUE (see README).
